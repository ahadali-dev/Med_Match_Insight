# --- Google service account (read-only access to client sheets) ---
# From the service account's JSON key file: "client_email" and "private_key".
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboards@your-project.iam.gserviceaccount.com
# Keep the quotes and the \n sequences exactly as they appear in the JSON file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Clients: one entry per Google Sheet ---
CLIENTS=[{"name":"Riverbend Medical Group","sheetId":"PASTE_SHEET_ID_HERE"}]
# Single client shortcut instead of CLIENTS:
# SHEET_ID=PASTE_SHEET_ID_HERE
# CLIENT_NAME=Riverbend Medical Group

# --- Optional ---
# Hide the "Sample data" badge for real client data:
# SAMPLE_DATA_BADGE=false
# Use the built-in fake data without any Google account (local look-around only):
# USE_LOCAL_SAMPLE=1

# --- Only for `npm run seed` ---
# SEED_SHARE_WITH=you@example.com
# SEED_SPREADSHEET_ID=   # populate an existing empty sheet instead of creating one
